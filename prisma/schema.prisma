generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model activities {
  id                  BigInt            @id @default(autoincrement())
  lesson_id           BigInt?
  creator_id          BigInt?
  title               String            @db.VarChar(150)
  activity_type       String?           @default("quiz") @db.VarChar(20)
  passing_score       Int?              @default(70)
  source_document_url String?
  is_public           Boolean?          @default(true)
  created_at          DateTime?         @default(now()) @db.Timestamp(6)
  users               users?            @relation(fields: [creator_id], references: [id], onUpdate: NoAction)
  lessons             lessons?          @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  activity_scores     activity_scores[]
  questions           questions[]
}

model activity_scores {
  id          BigInt     @id @default(autoincrement())
  user_id     BigInt
  activity_id BigInt
  score       Int        @default(0)
  passed      Boolean?   @default(false)
  played_at   DateTime?  @default(now()) @db.Timestamp(6)
  activities  activities @relation(fields: [activity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model answer_options {
  id          BigInt    @id @default(autoincrement())
  question_id BigInt
  answer_text String
  is_correct  Boolean?  @default(false)
  questions   questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model courses {
  id          BigInt    @id @default(autoincrement())
  title       String    @db.VarChar(150)
  description String?
  level       String?   @db.VarChar(50)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  lessons     lessons[]
}

model lessons {
  id              BigInt          @id @default(autoincrement())
  course_id       BigInt
  title           String          @db.VarChar(150)
  content         String?
  sequence_number Int
  created_at      DateTime?       @default(now()) @db.Timestamp(6)
  activities      activities[]
  courses         courses         @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_progress   user_progress[]
}

model questions {
  id             BigInt           @id @default(autoincrement())
  activity_id    BigInt
  question_text  String
  question_type  String?          @default("multiple_choice") @db.VarChar(50)
  points         Int?             @default(10)
  answer_options answer_options[]
  activities     activities       @relation(fields: [activity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_progress {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  lesson_id  BigInt
  progress   Int?      @default(0)
  completed  Boolean?  @default(false)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  lessons    lessons   @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, lesson_id])
}

model users {
  id              BigInt            @id @default(autoincrement())
  username        String            @unique @db.VarChar(50)
  email           String            @unique @db.VarChar(255)
  password_hash   String
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  activities      activities[]
  activity_scores activity_scores[]
  user_progress   user_progress[]
  user_quizzes    user_quizzes[]
}

model user_quizzes {
  id         String   @id
  user_id    BigInt?
  quiz_data  Json
  is_public  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  users      users?   @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
